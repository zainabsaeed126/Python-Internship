    {
      "cell_type": "code",
      "source": [
        "import csv\n",
        "\n",
        "# Read CSV file\n",
        "with open(\"students.csv\", \"r\") as file:\n",
        "    data = csv.reader(file)\n",
        "\n",
        "    for row in data:\n",
        "        print(row)\n",
        "\n",
        "# Write CSV file\n",
        "with open(\"new_students.csv\", \"w\", newline=\"\") as file:\n",
        "    writer = csv.writer(file)\n",
        "\n",
        "    writer.writerow([\"Name\", \"Age\"])\n",
        "    writer.writerow([\"Ali\", 20])\n",
        "    writer.writerow([\"Sara\", 21])"
      ],
