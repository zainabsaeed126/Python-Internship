    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "data = {\n",
        "    \"Name\": [\"Ali\", \"Sara\", \"Ali\", \"Ahmed\"],\n",
        "    \"Marks\": [80, 90, None, 70]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(df)\n",
        "\n",
        "# Fill missing values\n",
        "df[\"Marks\"] = df[\"Marks\"].fillna(0)\n",
        "\n",
        "# Filter\n",
        "print(df[df[\"Marks\"] > 75])\n",
        "\n",
        "# Group By\n",
        "print(df.groupby(\"Name\")[\"Marks\"].mean())"
      ],
