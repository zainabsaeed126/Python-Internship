        "\n",
        "    if age < 18:\n",
        "        raise AgeError(\"Age must be 18 or above.\")\n",
        "\n",
        "    print(\"Valid Age\")\n",
        "\n",
        "except AgeError as e:\n",
        "    logging.error(e)"
